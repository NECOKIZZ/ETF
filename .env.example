# Binance Web3 API (https://web3.binance.com/en/dev-portal). Server only, never commit real values.
# The API refuses requests from restricted regions (e.g. the US): run from an allowed location.
BINANCE_W3_API_KEY=
BINANCE_W3_SECRET_KEY=

# BSC deploy (contracts/script/DeployLeague.s.sol)
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
DEPLOYER_PRIVATE_KEY=
STAKE_TOKEN=0x55d398326f99059fF775485246999027B3197955
KEEPER=
LEAGUE_TOKENS=

# Keeper + hosting (docs/HOSTING.md)
KEEPER_PRIVATE_KEY=
ESCROW_ADDRESS=
# Supabase stores keeper data when set (needed on Vercel); otherwise ./data
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Bearer token the cron sends to /api/keeper/tick
CRON_SECRET=
