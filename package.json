{
  "name": "etf-league",
  "version": "0.1.0",
  "private": true,
  "description": "ETF League: on-chain stock ETFs on BNB Chain compete in weekly leagues. Built for BNB Hack: Tokenized Stocks Edition.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "vitest run",
    "test:contracts": "cd contracts && forge test",
    "typecheck": "tsc --noEmit",
    "rwa:tokens": "tsx --env-file=.env.local scripts/rwa-tokens.mts"
  },
  "dependencies": {
    "viem": "^2.55.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
