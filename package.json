{
  "name": "league-of-stocks",
  "version": "0.1.0",
  "private": true,
  "description": "League of Stocks: on-chain stock ETFs on BNB Chain compete in weekly leagues. Built for BNB Hack: Tokenized Stocks Edition.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:contracts": "cd contracts && forge test",
    "typecheck": "tsc --noEmit",
    "rwa:tokens": "tsx --env-file=.env.local scripts/rwa-tokens.mts",
    "quote": "tsx --env-file=.env.local scripts/quote.mts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "next build && next start -p 8080",
    "dev:8080": "next dev -p 8080",
    "keeper": "tsx --env-file-if-exists=.env.local scripts/keeper.mts",
    "buy-plan": "tsx --env-file=.env.local scripts/buy-plan.mts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "viem": "^2.55.8",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
